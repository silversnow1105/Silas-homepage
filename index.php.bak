                    <?php
                    if (mysqli_num_rows($result) > 0) {
                        while($row = mysqli_fetch_assoc($result)) {
                            echo '<div class="post-item">';
                            echo '<div class="post-user">' . htmlspecialchars($row['username']) . '</div>';
                            echo '<div>' . htmlspecialchars($row['content']) . '</div>';
                            echo '</div>';
                        }
                    }
                    mysqli_close($conn);
                    ?>
                </div>
            </div>
